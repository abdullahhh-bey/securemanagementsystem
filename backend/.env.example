# Copy to .env (git-ignored) and fill in real values.
# Do not commit real passwords or connection strings.

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_NAME=examflow_token

# Initial Admin seed (used by `npm run db:seed` / prisma/seed.js)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_NAME=System Administrator
