# Copy to .env (git-ignored) and adjust.
#
# Base URL of the real API.
# Leave empty in local development so requests stay same-origin and the Vite
# proxy (vite.config.js) forwards /api to http://localhost:3000. That keeps
# HTTP-only auth cookies working without CORS.
# Set to an absolute URL only when the API is on another origin and CORS is configured.
VITE_API_URL=
#
# true  -> every API function returns fictional data from src/api/mock (no backend needed)
# false -> real fetch calls against VITE_API_URL (or same-origin / Vite proxy)
VITE_USE_MOCK=false
